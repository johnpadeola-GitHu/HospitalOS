# E2E test credentials. Copy this file to .env and fill in real values —
# .env itself is gitignored and must never be committed.
#
# The Super Admin (demo) account already exists — see e2e/README.md.
# The role-specific accounts need to be created first, under
# Administration → Users & roles, signed in as the demo Super Admin —
# do NOT use real hospital staff credentials for automated testing.

SUPERADMIN_EMAIL=demo@agorox.africa
SUPERADMIN_PASSWORD=

CASHIER_EMAIL=
CASHIER_PASSWORD=

NURSE_EMAIL=
NURSE_PASSWORD=

PHARMACIST_EMAIL=
PHARMACIST_PASSWORD=
